# Vite build-time environment for the Gofixo web app
# Create a separate Google Maps JavaScript API key. Restrict it by HTTP referrer
# to the production web origins and enable Maps JavaScript API for that key.
# Do NOT put the server-side GOOGLE_MAPS_API_KEY in this file.
VITE_GOOGLE_MAPS_API_KEY=replace_with_browser_restricted_maps_javascript_key
