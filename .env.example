# Gofixo Backend — environment variables
# Copy this to .env and fill in real values. Never commit .env itself.

PORT=4000
NODE_ENV=development

# Separate database from mob13r-db — same RDS instance, different DB name
DATABASE_URL=postgresql://gofixo_admin:PASSWORD@mob13r-db.cpswoqw4opaa.ap-south-1.rds.amazonaws.com:5432/gofixo-db

JWT_SECRET=replace_with_a_long_random_string

ADMIN_SECRET=replace_with_a_strong_admin_password

# CORS — which frontend(s) can call this API
FRONTEND_BASE_URL=https://gofixo.mob13r.com

# Google Maps Platform server-side APIs (keep the real key in deployment secrets)
GOOGLE_MAPS_API_KEY=replace_with_restricted_server_api_key

# Manual personal UPI QR top-ups (manual bank verification; no automatic credit from UTR)
# Configure these in the backend deployment environment only; never commit real account values.
GOFIXO_UPI_ID=replace_with_official_upi_id
GOFIXO_UPI_PAYEE_NAME=Gofixo
GOFIXO_UPI_QR_IMAGE_URL=

# Cashfree Payment Gateway. Keep credentials in the deployment environment only.
# Start with sandbox; use production only after Cashfree activates live payments.
CASHFREE_CLIENT_ID=replace_with_cashfree_client_id
CASHFREE_CLIENT_SECRET=replace_with_cashfree_client_secret
CASHFREE_ENV=sandbox
CASHFREE_RETURN_URL=https://gofixo.mob13r.com/api/wallet/payment-return?order_id={order_id}
CASHFREE_WEBHOOK_URL=https://gofixo.mob13r.com/api/wallet/webhooks/cashfree

# Platform commission for home-service wallet bookings (percentage, 0-50).
GOFIXO_COMMISSION_PERCENT=20

# Web Push (generate a VAPID key pair on the server; never commit the private key)
VAPID_SUBJECT=mailto:admin@gofixo.mob13r.com
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
