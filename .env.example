# Gofixo Backend — environment variables
# Copy this to .env and fill in real values. Never commit .env itself.

PORT=4000
NODE_ENV=development

# Separate database from mob13r-db — same RDS instance, different DB name
DATABASE_URL=postgresql://gofixo_admin:PASSWORD@mob13r-db.cpswoqw4opaa.ap-south-1.rds.amazonaws.com:5432/gofixo-db

JWT_SECRET=replace_with_a_long_random_string

ADMIN_SECRET=replace_with_a_strong_admin_password

# MSG91 (SMS OTP) — leave both blank until DLT template is approved; system falls back to
# returning the OTP in the API response for testing until then
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# CORS — which frontend(s) can call this API
FRONTEND_BASE_URL=https://gofixo.mob13r.com
